{
  "format": "kristal.editorial-layout/0.1",
  "id": "taxonomy-tree",
  "version": "0.1.0",
  "intent": "explicit_semantik_realized_taxonomy_without_structural_inference",
  "audience": "technical_and_editorial",
  "render_policy": {
    "mode": "typed_explicit_units_only",
    "auto_select_assertions": false,
    "derive_edges": false,
    "semantic_realizations_required": true,
    "release_c1_c2_c3_external": true,
    "warning": "A rendered card does not validate graph topology, balancing, periods or source authority."
  },
  "slots": {
    "scope": {
      "allowed_kinds": [
        "context"
      ],
      "min": 1,
      "max": 1
    },
    "concepts": {
      "allowed_kinds": [
        "concept"
      ],
      "min": 2,
      "max": 20
    },
    "specializations": {
      "allowed_kinds": [
        "relation"
      ],
      "min": 1,
      "max": 32
    },
    "limits": {
      "allowed_kinds": [
        "qualification"
      ],
      "min": 1,
      "max": 4
    }
  }
}

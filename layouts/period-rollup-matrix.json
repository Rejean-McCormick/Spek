{
  "format": "kristal.editorial-layout/0.1",
  "id": "period-rollup-matrix",
  "version": "0.1.0",
  "intent": "explicit_semantik_realized_matrix_without_structural_inference",
  "audience": "technical_and_editorial",
  "render_policy": {
    "mode": "typed_explicit_units_only",
    "auto_select_assertions": false,
    "derive_edges": false,
    "semantic_realizations_required": true,
    "release_c1_c2_c3_external": true,
    "warning": "A rendered card does not validate graph topology, balancing, periods or source authority."
  },
  "slots": {
    "context": {
      "allowed_kinds": [
        "context"
      ],
      "min": 1,
      "max": 1
    },
    "axes": {
      "allowed_kinds": [
        "concept",
        "criterion"
      ],
      "min": 2,
      "max": 12
    },
    "entries": {
      "allowed_kinds": [
        "relation",
        "observation"
      ],
      "min": 1,
      "max": 32
    },
    "limits": {
      "allowed_kinds": [
        "qualification"
      ],
      "min": 1,
      "max": 4
    }
  }
}

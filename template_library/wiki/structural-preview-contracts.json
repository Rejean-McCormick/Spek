    "mandatory_fields": [
      "assertion_id",
      "statement.subject",
      "statement.predicate",
      "statement.object"
    ],
    "prohibited": [
      "new facts",
      "temporal inference",
      "template selection at runtime",
      "language generation",
      "publication"
    ]
  },
  "output_contract": "offline inspection-structurelle.html + inspection-manifest.json; not a production Wiki surface",

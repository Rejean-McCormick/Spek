{
  "format": "spek.template-graph/1.0",
  "template_id": "rhetorical.pdtb-level-of-detail",
  "version": "1.0.0",
  "category": "rhetorical",
  "intent": "Aperçu suivi de précisions",
  "research_basis": {
    "family": "discourse",
    "relation": "pdtb.expansion.level-of-detail",
    "source": "PDTB",
    "source_url": "https://catalog.ldc.upenn.edu/docs/LDC2019T05/PDTB3-Annotation-Manual.pdf",
    "adaptation": "Spek non-normative"
  },
  "rhetorical_contract": {
    "relationship_label": "pdtb.expansion.level-of-detail",
    "editorial_relation_required": true,
    "semantic_warning": "Chaque précision doit référer à l’aperçu.",
    "critical_questions": []
  },
  "slots": {
    "overview": {
      "node_kind": "text",
      "min": 1,
      "max": 1,
      "allowed_kinds": [
        "claim"
      ],
      "visual_role": "paragraph"
    },
    "detail": {
      "node_kind": "text",
      "min": 1,
      "max": 8,
      "allowed_kinds": [
        "context"
      ],
      "visual_role": "paragraph"
    }
  },
  "ordered_slots": [
    "overview",
    "detail"
  ],
  "presentation_policy": {
    "layout_variant": "flow",
    "show_template_labels": false,
    "paragraph_break_before_slots": []
  },
  "no_fact_selection": true,
  "no_text_generation": true,
  "discourse_model": {
    "format": "spek.discourse-model/1.0",
    "scope": "editorial_adaptation_not_a_normative_semantic_validator",
    "relation_tag": "pdtb.expansion.level-of-detail",
    "focus_slot": "overview",
    "moves": [
      {
        "slot": "overview",
        "function": "overview",
        "nuclearity": "focus",
        "group": 1,
        "surface_role": "paragraph"
      },
      {
        "slot": "detail",
        "function": "detail",
        "nuclearity": "supporting",
        "group": 1,
        "surface_role": "paragraph"
      }
    ],
    "links": [
      {
        "from_slot": "detail",
        "to_slot": "overview",
        "relation": "pdtb.expansion.level-of-detail",
        "status": "requires_external_semantic_review",
        "relation_function": "elaborates"
      }
    ],
    "paragraph_groups": [
      [
        "overview",
        "detail"
      ]
    ],
    "cohesion": {
      "connectives": "only_explicit_semantik_realizations",
      "rewrite_existing_phrases": false,
      "infer_relations_from_adjacent_slots": false,
      "text_without_realization": "refuse",
      "transition_slot_policy": "optional_explicit_text_slot_only"
    },
    "semantic_review": {
      "required_for_publication": true,
      "checked_by_spek": false,
      "questions": [],
      "warning": "Chaque précision doit référer à l’aperçu."
    }
  }
}

{
  "format": "spek.template-graph/1.0",
  "template_id": "rhetorical.argument-evidence",
  "version": "1.0.0",
  "category": "rhetorical",
  "intent": "arrange_an_explicit_thesis_and_evidence_into_argumentative_order",
  "slots": {
    "thesis": {
      "node_kind": "child",
      "allowed_templates": [
        "rhetorical.assertion@1.0.0"
      ],
      "min": 1,
      "max": 1
    },
    "evidence": {
      "node_kind": "child",
      "allowed_templates": [
        "rhetorical.evidence@1.0.0"
      ],
      "min": 1,
      "max": 10
    },
    "inference": {
      "node_kind": "text",
      "allowed_kinds": [
        "inference"
      ],
      "min": 1,
      "max": 1,
      "visual_role": "paragraph"
    },
    "objection": {
      "node_kind": "child",
      "allowed_templates": [
        "rhetorical.qualification@1.0.0"
      ],
      "min": 1,
      "max": 1
    },
    "conclusion": {
      "node_kind": "child",
      "allowed_templates": [
        "rhetorical.conclusion@1.0.0"
      ],
      "min": 1,
      "max": 1
    }
  },
  "ordered_slots": [
    "thesis",
    "evidence",
    "inference",
    "objection",
    "conclusion"
  ],
  "presentation_policy": {
    "layout_variant": "flow",
    "lead_slot": "thesis",
    "show_template_labels": false
  },
  "no_fact_selection": true,
  "no_text_generation": true
}
